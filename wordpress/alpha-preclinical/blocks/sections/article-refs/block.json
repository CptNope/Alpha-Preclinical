{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "alpha/article-refs",
 "title": "Article refs",
 "category": "alpha-sections",
 "description": "Section from the approved design, used on: blog post, blog post.",
 "icon": "layout",
 "textdomain": "alpha-preclinical",
 "attributes": {
  "h2": {
   "type": "string",
   "default": "Sources"
  },
  "li_items": {
   "type": "array",
   "default": [
    {
     "li": "<a href=\"https://alzet.com/products/alzet_pumps/how-does-it-work/\" rel=\"noopener\">Alzet pump</a>"
    },
    {
     "li": "<a href=\"https://alzet.com/products/ALZET_pumps/specifications/\" rel=\"noopener\">three sizes</a>"
    }
   ]
  }
 },
 "supports": {
  "html": false,
  "customClassName": false,
  "className": false,
  "reusable": false
 },
 "render": "file:./render.php",
 "alphaRegion": "main",
 "alphaFields": {
  "h2": {
   "type": "html",
   "label": "Heading"
  },
  "li_items": {
   "type": "items",
   "label": "List item (list)",
   "fields": {
    "li": {
     "type": "html",
     "label": "List item"
    }
   }
  }
 }
}