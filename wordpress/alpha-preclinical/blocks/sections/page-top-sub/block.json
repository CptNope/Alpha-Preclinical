{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "alpha/page-top-sub",
 "title": "Page header (three-level breadcrumb)",
 "category": "alpha-sections",
 "description": "Section from the approved design, used on: Tumor models, Team.",
 "icon": "layout",
 "textdomain": "alpha-preclinical",
 "attributes": {
  "nav_aria_label": {
   "type": "string",
   "default": "Breadcrumb"
  },
  "li_items": {
   "type": "array",
   "default": [
    {
     "li": "<a href=\"/\">Home</a>"
    },
    {
     "li": "<a href=\"/expertise/\">Expertise</a>"
    }
   ]
  },
  "li": {
   "type": "string",
   "default": "Tumor models"
  },
  "h1": {
   "type": "string",
   "default": "Tumor models for in vivo oncology efficacy studies"
  },
  "p": {
   "type": "string",
   "default": "Syngeneic and xenograft models run by scientists who have designed oncology studies for decades, with tumor burden tracked by caliper and by bioluminescent IVIS imaging."
  },
  "motion_toggle": {
   "type": "string",
   "default": "Pause animation"
  }
 },
 "supports": {
  "html": false,
  "customClassName": false,
  "className": false,
  "reusable": false
 },
 "render": "file:./render.php",
 "alphaRegion": "header",
 "alphaFields": {
  "nav_aria_label": {
   "type": "text",
   "label": "Nav screen reader label"
  },
  "li_items": {
   "type": "items",
   "label": "List item (list)",
   "fields": {
    "li": {
     "type": "html",
     "label": "List item"
    }
   }
  },
  "li": {
   "type": "html",
   "label": "List item"
  },
  "h1": {
   "type": "html",
   "label": "Heading"
  },
  "p": {
   "type": "html",
   "label": "Text"
  },
  "motion_toggle": {
   "type": "html",
   "label": "Animation button text"
  }
 }
}