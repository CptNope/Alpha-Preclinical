   "type": "string",
   "default": "First name"
  },
  "label_2": {
   "type": "string",
   "default": "Last name"
  },
  "label_3": {
   "type": "string",
   "default": "Email"
  },
  "err": {
   "type": "string",
   "default": "Enter an email address so we can reply."
  },
  "label_4": {
   "type": "string",
   "default": "Phone <small>(optional)</small>"
  },
  "label_5": {
   "type": "string",
   "default": "Role"
  },
  "label_6": {
   "type": "string",
   "default": "Resume <small>(PDF or Word)</small>"
  },
  "label_7": {
   "type": "string",
   "default": "Tell us about your experience <small>(optional)</small>"
  },
  "textarea_placeholder": {
   "type": "string",
   "default": "Species, techniques, CRO or lab experience, and what you'd like to do next"
  },
  "btn_primary": {
   "type": "string",
   "default": "Submit application"
  },
  "p": {
   "type": "string",
