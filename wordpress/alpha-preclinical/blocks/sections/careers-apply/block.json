  },
  "h3": {
   "type": "string",
   "default": "Application submitted"
  },
  "p_2": {
   "type": "string",
   "default": "Thanks for applying for <span data-role-out=\"\"></span>. We'll reply to <span data-email-out=\"\"></span> if there's a fit."
  },
  "button": {
   "type": "string",
   "default": "Submit another application"
  }
 },
