  "p_items": {
   "type": "array",
   "default": [
    {
     "p": "Ashley Kolofsky supervises Alpha Preclinical's study team and oversees day-to-day vivarium operations at its Worcester facility. A founding member of the research team since 2020, she coordinates study schedules so that dosing, sampling and observations happen when the protocol says they should, and she leads Alpha's rodent colony management and custom breeding programs."
    },
    {
     "p": "She holds a BS in zoology from the University of Maine, Orono, and completed field studies with the School for Field Studies in Karatu, Tanzania. She brings that grounding in animal biology and welfare to every study, and values applying it to research with a direct human impact."
    }
   ]
  },
