  "role_2": {
   "type": "string",
   "default": "Founding Scientist, In Vitro Laboratory Services"
  },
  "p_items_2": {
   "type": "array",
   "default": [
    {
     "p": "Cindy Hopper is a founding scientist at Alpha Preclinical and leads its in vitro laboratory services: multicolor flow cytometry and immunophenotyping, ELISA and cytokine assays, CBC and serum chemistry, primary cell isolation, and histology and immunohistochemistry on the samples clients' in vivo studies generate. Because the lab sits beside the vivarium, samples are processed fresh, on site."
    },
    {
     "p": "She also leads project development, working with client teams to solve the technical problems that stand between a program and its study goals. Cindy earned an associate degree at Quinsigamond Community College and continued her studies at Worcester Polytechnic Institute."
    },
    {
     "p": "She is motivated by biotech's capacity to change what is possible for patients, and by preventive approaches to medicine."
    }
   ]
  },
  "h4_3": {
