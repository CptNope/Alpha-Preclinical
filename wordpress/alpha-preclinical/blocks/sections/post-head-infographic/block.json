{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "alpha/post-head-infographic",
 "title": "Post head infographic",
 "category": "alpha-sections",
 "description": "Section from the approved design, used on: blog post, blog post, blog post, blog post.",
 "icon": "layout",
 "textdomain": "alpha-preclinical",
 "attributes": {
  "nav_aria_label": {
   "type": "string",
   "default": "Breadcrumb"
  },
  "li_items": {
   "type": "array",
   "default": [
    {
     "li": "<a href=\"/\">Home</a>"
    },
    {
     "li": "<a href=\"/blog/\">Blog</a>"
    }
   ]
  },
  "li": {
   "type": "string",
   "default": "Tumor models"
  },
  "tag": {
   "type": "string",
   "default": "Tumor models"
  },
  "h1": {
   "type": "string",
   "default": "Caliper or IVIS? Choosing how to measure tumor burden"
  },
  "dek": {
   "type": "string",
   "default": "When are caliper measurements enough, and when does bioluminescent IVIS imaging earn its cost? A practical guide for oncology efficacy studies."
  },
  "who_items": {
   "type": "array",
   "default": [
    {
     "img_img": "assets/img/team/barak-yahalom.jpg",
     "div": "<b><a href=\"/team/#barak-yahalom\">Barak Yahalom, DVM</a></b><small>CEO and Chief Scientific Officer</small>"
    },
    {
     "img_img": "assets/img/team/joan-flanagan.jpg",
     "div": "<small>Scientific review by</small><b><a href=\"/team/#joan-flanagan\">Joan Flanagan, PhD</a></b>"
    }
   ]
  },
  "dates": {
   "type": "string",
   "default": "<b>Published</b> [Date]<br/><b>Updated</b> [Date], 3 min read"
  },
  "img_img": {
   "type": "string",
   "default": "assets/img/blog/caliper-vs-ivis-hero-1200.jpg"
  },
  "img_srcset": {
   "type": "string",
   "default": "assets/img/blog/caliper-vs-ivis-hero-1200.jpg 1200w, assets/img/blog/caliper-vs-ivis-hero-1672.jpg 1672w"
  },
  "img_sizes": {
   "type": "string",
   "default": "(max-width: 1080px) 100vw, 820px"
  },
  "img_width": {
   "type": "string",
   "default": "1672"
  },
  "img_height": {
   "type": "string",
   "default": "941"
  },
  "img_alt": {
   "type": "string",
   "default": "Illustration: one scientist measures tumors with digital calipers while a colleague presents a bioluminescence imaging system and its heat-map results on a monitor."
  },
  "figcaption": {
   "type": "string",
   "default": "Calipers and bioluminescence imaging measure tumor burden in different ways, and suit different models."
  }
 },
 "supports": {
  "html": false,
  "customClassName": false,
  "className": false,
  "reusable": false
 },
 "render": "file:./render.php",
 "alphaRegion": "main",
 "alphaFields": {
  "nav_aria_label": {
   "type": "text",
   "label": "Nav screen reader label"
  },
  "li_items": {
   "type": "items",
   "label": "List item (list)",
   "fields": {
    "li": {
     "type": "html",
     "label": "List item"
    }
   }
  },
  "li": {
   "type": "html",
   "label": "List item"
  },
  "tag": {
   "type": "html",
   "label": "Topic tag"
  },
  "h1": {
   "type": "html",
   "label": "Heading"
  },
  "dek": {
   "type": "html",
   "label": "Summary line"
  },
  "who_items": {
   "type": "items",
   "label": "Who (list)",
   "fields": {
    "img_img": {
     "type": "image",
     "label": "Img image"
    },
    "div": {
     "type": "html",
     "label": "Content"
    }
   }
  },
  "dates": {
   "type": "html",
   "label": "Dates and reading time"
  },
  "img_img": {
   "type": "image",
   "label": "Img image"
  },
  "img_srcset": {
   "type": "srcset",
   "label": "Img image sizes (srcset)"
  },
  "img_sizes": {
   "type": "text",
   "label": "Img sizes"
  },
  "img_width": {
   "type": "text",
   "label": "Img image width"
  },
  "img_height": {
   "type": "text",
   "label": "Img image height"
  },
  "img_alt": {
   "type": "text",
   "label": "Img image description (alt text)"
  },
  "figcaption": {
   "type": "html",
   "label": "Caption"
  }
 }
}