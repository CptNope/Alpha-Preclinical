{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "alpha/post-head",
 "title": "Post head",
 "category": "alpha-sections",
 "description": "Section from the approved design, used on: blog post, blog post, blog post.",
 "icon": "layout",
 "textdomain": "alpha-preclinical",
 "attributes": {
  "nav_aria_label": {
   "type": "string",
   "default": "Breadcrumb"
  },
  "li_items": {
   "type": "array",
   "default": [
    {
     "li": "<a href=\"/\">Home</a>"
    },
    {
     "li": "<a href=\"/blog/\">Blog</a>"
    }
   ]
  },
  "li": {
   "type": "string",
   "default": "Study design"
  },
  "tag": {
   "type": "string",
   "default": "Study design"
  },
  "h1": {
   "type": "string",
   "default": "Continuous dosing with Alzet pumps: when and why"
  },
  "dek": {
   "type": "string",
   "default": "When continuous infusion beats daily injections: how Alzet osmotic pumps work, choosing a model, and subcutaneous vs ICV delivery in mice and rats."
  },
  "who_items": {
   "type": "array",
   "default": [
    {
     "img_img": "assets/img/team/gil-chacon.jpg",
     "div": "<b><a href=\"/team/#gil-chacon\">Gil Chacon</a></b><small>In Vivo Studies, Surgical Support and Training</small>"
    },
    {
     "img_img": "assets/img/team/barak-yahalom.jpg",
     "div": "<small>Scientific review by</small><b><a href=\"/team/#barak-yahalom\">Barak Yahalom, DVM</a></b>"
    }
   ]
  },
  "dates": {
   "type": "string",
   "default": "<b>Published</b> [Date]<br/><b>Updated</b> [Date], 3 min read"
  },
  "img_img": {
   "type": "string",
   "default": "assets/img/team-group.jpg"
  },
  "img_alt": {
   "type": "string",
   "default": "The Alpha Preclinical team outside the Worcester facility"
  },
  "figcaption": {
   "type": "string",
   "default": "The Alpha in vivo and surgical team."
  }
 },
 "supports": {
  "html": false,
  "customClassName": false,
  "className": false,
  "reusable": false
 },
 "render": "file:./render.php",
 "alphaRegion": "main",
 "alphaFields": {
  "nav_aria_label": {
   "type": "text",
   "label": "Nav screen reader label"
  },
  "li_items": {
   "type": "items",
   "label": "List item (list)",
   "fields": {
    "li": {
     "type": "html",
     "label": "List item"
    }
   }
  },
  "li": {
   "type": "html",
   "label": "List item"
  },
  "tag": {
   "type": "html",
   "label": "Topic tag"
  },
  "h1": {
   "type": "html",
   "label": "Heading"
  },
  "dek": {
   "type": "html",
   "label": "Summary line"
  },
  "who_items": {
   "type": "items",
   "label": "Who (list)",
   "fields": {
    "img_img": {
     "type": "image",
     "label": "Img image"
    },
    "div": {
     "type": "html",
     "label": "Content"
    }
   }
  },
  "dates": {
   "type": "html",
   "label": "Dates and reading time"
  },
  "img_img": {
   "type": "image",
   "label": "Img image"
  },
  "img_alt": {
   "type": "text",
   "label": "Img image description (alt text)"
  },
  "figcaption": {
   "type": "html",
   "label": "Caption"
  }
 }
}