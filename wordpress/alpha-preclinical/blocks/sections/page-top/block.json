{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "alpha/page-top",
 "title": "Page header",
 "category": "alpha-sections",
 "description": "Section from the approved design, used on: About, Publications, Contact, Blog.",
 "icon": "layout",
 "textdomain": "alpha-preclinical",
 "attributes": {
  "nav_aria_label": {
   "type": "string",
   "default": "Breadcrumb"
  },
  "li": {
   "type": "string",
   "default": "<a href=\"/\">Home</a>"
  },
  "li_2": {
   "type": "string",
   "default": "About"
  },
  "h1": {
   "type": "string",
   "default": "A preclinical partner built by people who've run the studies"
  },
  "p": {
   "type": "string",
   "default": "Alpha Preclinical is a US-owned discovery research company in Worcester, Massachusetts. We were founded in 2020 by scientists and technicians who spent decades in pharma, biotech and contract research."
  },
  "motion_toggle": {
   "type": "string",
   "default": "Pause animation"
  }
 },
 "supports": {
  "html": false,
  "customClassName": false,
  "className": false,
  "reusable": false
 },
 "render": "file:./render.php",
 "alphaRegion": "header",
 "alphaFields": {
  "nav_aria_label": {
   "type": "text",
   "label": "Nav screen reader label"
  },
  "li": {
   "type": "html",
   "label": "List item"
  },
  "li_2": {
   "type": "html",
   "label": "List item 2"
  },
  "h1": {
   "type": "html",
   "label": "Heading"
  },
  "p": {
   "type": "html",
   "label": "Text"
  },
  "motion_toggle": {
   "type": "html",
   "label": "Animation button text"
  }
 }
}