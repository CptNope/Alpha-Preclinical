{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Abyss (deep blue)",
	"slug": "section-abyss",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column",
		"core/cover"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|abyss",
			"text": "var:preset|color|paper"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|paper"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|paper"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|shallows"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|shallows",
					"text": "var:preset|color|abyss"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|paper",
						"text": "var:preset|color|abyss"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|ink-on-abyss"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "rgba(185,204,227,0.25)"
				}
			},
			"core/table": {
				"color": {
					"text": "var:preset|color|paper"
				}
			}
		}
	}
}
