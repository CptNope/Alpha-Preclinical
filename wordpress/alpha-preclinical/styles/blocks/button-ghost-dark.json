{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Ghost (on dark)",
	"slug": "ghost-dark",
	"blockTypes": [
		"core/button"
	],
	"styles": {
		"color": {
			"background": "transparent",
			"text": "var:preset|color|paper"
		},
		"shadow": "inset 0 0 0 1.5px rgba(185,204,227,0.55)",
		":hover": {
			"color": {
				"background": "transparent",
				"text": "var:preset|color|paper"
			},
			"shadow": "inset 0 0 0 1.5px #FFFFFF"
		}
	}
}
